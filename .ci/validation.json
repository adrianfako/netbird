{
  "version": 1,
  "profile": "mixed",
  "adapter_status": "configured",
  "checks": [
    {
      "name": "validation-regressions",
      "argv": [
        "python3",
        ".ci/test_validate.py"
      ],
      "timeout": 60
    },
    {
      "name": "signal-peer-tests",
      "argv": [
        "go",
        "test",
        "-tags",
        "devcert",
        "./signal/peer"
      ],
      "timeout": 900
    },
    {
      "name": "lab-failure-reporting",
      "argv": [
        "python3",
        "tests/regional-failover/test_run.py"
      ],
      "timeout": 60
    }
  ],
  "setup": [],
  "requires_uv": false,
  "notes": [
    "Foundation syntax checks are not behavioral tests. Security scanning is a separate workflow job.",
    "Focused upstream Signal peer tests only; regional failover and broader application behavior remain unverified."
  ],
  "default_branch": "main"
}
